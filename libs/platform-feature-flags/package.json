{
    "name": "@pixel-brewery/archipel-platform-feature-flags",
    "version": "0.1.28",
    "description": "Provider-agnostic feature flag infrastructure for NestJS with support for Azure App Configuration and Vercel Edge Config.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "azure": [
                "./src/azure/index.d.ts"
            ],
            "vercel": [
                "./src/vercel/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./azure": {
            "types": "./src/azure/index.d.ts",
            "import": "./src/azure/index.js",
            "default": "./src/azure/index.js"
        },
        "./vercel": {
            "types": "./src/vercel/index.d.ts",
            "import": "./src/vercel/index.js",
            "default": "./src/vercel/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-feature-flags"
    },
    "keywords": [
        "nestjs",
        "feature-flags",
        "feature-toggles",
        "azure",
        "azure-app-configuration",
        "vercel",
        "edge-config",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@pixel-brewery/archipel-platform-configuration": "0.1.28",
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@azure/app-configuration": ">=1.8.0",
        "@azure/app-configuration-provider": ">=2.0.0",
        "@azure/identity": ">=4.0.0",
        "@microsoft/feature-management": ">=2.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@vercel/edge-config": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "@azure/app-configuration": {
            "optional": true
        },
        "@azure/app-configuration-provider": {
            "optional": true
        },
        "@azure/identity": {
            "optional": true
        },
        "@microsoft/feature-management": {
            "optional": true
        },
        "@vercel/edge-config": {
            "optional": true
        }
    },
    "devDependencies": {
        "@azure/app-configuration": "1.13.1",
        "@azure/app-configuration-provider": "2.6.0",
        "@azure/identity": "4.14.0",
        "@microsoft/feature-management": "2.3.1",
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "@vercel/edge-config": "1.5.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Identity & Access"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
