{
    "name": "@pixel-brewery/archipel-platform-payments",
    "version": "0.1.28",
    "description": "Provider-agnostic payment infrastructure for NestJS with support for Stripe, Paddle, LemonSqueezy, and Mollie.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "stripe": [
                "./src/stripe/index.d.ts"
            ],
            "paddle": [
                "./src/paddle/index.d.ts"
            ],
            "lemonsqueezy": [
                "./src/lemonsqueezy/index.d.ts"
            ],
            "mollie": [
                "./src/mollie/index.d.ts"
            ],
            "health": [
                "./src/health/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./stripe": {
            "types": "./src/stripe/index.d.ts",
            "import": "./src/stripe/index.js",
            "default": "./src/stripe/index.js"
        },
        "./paddle": {
            "types": "./src/paddle/index.d.ts",
            "import": "./src/paddle/index.js",
            "default": "./src/paddle/index.js"
        },
        "./lemonsqueezy": {
            "types": "./src/lemonsqueezy/index.d.ts",
            "import": "./src/lemonsqueezy/index.js",
            "default": "./src/lemonsqueezy/index.js"
        },
        "./mollie": {
            "types": "./src/mollie/index.d.ts",
            "import": "./src/mollie/index.js",
            "default": "./src/mollie/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-payments"
    },
    "keywords": [
        "nestjs",
        "payments",
        "stripe",
        "paddle",
        "lemonsqueezy",
        "mollie",
        "billing",
        "feature-guard",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@pixel-brewery/archipel-platform-configuration": "0.1.28",
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@lemonsqueezy/lemonsqueezy.js": ">=4.0.0",
        "@mollie/api-client": ">=4.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@paddle/paddle-node-sdk": ">=3.0.0",
        "@pixel-brewery/archipel-platform-health": "0.1.28",
        "rxjs": ">=7.0.0",
        "stripe": ">=23.0.0"
    },
    "peerDependenciesMeta": {
        "@lemonsqueezy/lemonsqueezy.js": {
            "optional": true
        },
        "@mollie/api-client": {
            "optional": true
        },
        "@nestjs/terminus": {
            "optional": true
        },
        "@paddle/paddle-node-sdk": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-health": {
            "optional": true
        },
        "stripe": {
            "optional": true
        }
    },
    "devDependencies": {
        "@lemonsqueezy/lemonsqueezy.js": "4.0.0",
        "@mollie/api-client": "4.6.0",
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "@paddle/paddle-node-sdk": "3.10.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "stripe": "23.0.0",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Identity & Access"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
