{
    "name": "@pixel-brewery/archipel-platform-authentication",
    "version": "0.1.27",
    "description": "JWT and OAuth authentication, MFA, session management, and email verification for NestJS applications.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "connectors/apple": [
                "./src/connectors/apple/index.d.ts"
            ],
            "connectors/github": [
                "./src/connectors/github/index.d.ts"
            ],
            "connectors/google": [
                "./src/connectors/google/index.d.ts"
            ],
            "connectors/microsoft": [
                "./src/connectors/microsoft/index.d.ts"
            ],
            "mfa/totp": [
                "./src/mfa/totp/index.d.ts"
            ],
            "health": [
                "./src/health/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./connectors/apple": {
            "types": "./src/connectors/apple/index.d.ts",
            "import": "./src/connectors/apple/index.js",
            "default": "./src/connectors/apple/index.js"
        },
        "./connectors/github": {
            "types": "./src/connectors/github/index.d.ts",
            "import": "./src/connectors/github/index.js",
            "default": "./src/connectors/github/index.js"
        },
        "./connectors/google": {
            "types": "./src/connectors/google/index.d.ts",
            "import": "./src/connectors/google/index.js",
            "default": "./src/connectors/google/index.js"
        },
        "./connectors/microsoft": {
            "types": "./src/connectors/microsoft/index.d.ts",
            "import": "./src/connectors/microsoft/index.js",
            "default": "./src/connectors/microsoft/index.js"
        },
        "./mfa/totp": {
            "types": "./src/mfa/totp/index.d.ts",
            "import": "./src/mfa/totp/index.js",
            "default": "./src/mfa/totp/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-authentication"
    },
    "keywords": [
        "nestjs",
        "authentication",
        "jwt",
        "oauth",
        "mfa",
        "passport",
        "session",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@pixel-brewery/archipel-platform-configuration": "0.1.27",
        "@pixel-brewery/archipel-platform-core": "0.1.27",
        "@pixel-brewery/archipel-platform-cryptography": "0.1.27",
        "@pixel-brewery/archipel-platform-mapping": "0.1.27",
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/jwt": "^12.0.0",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/swagger": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@pixel-brewery/archipel-platform-health": "0.1.27",
        "class-transformer": ">=0.5.0",
        "class-validator": ">=0.14.0",
        "express": ">=5.0.0",
        "passport": ">=0.7.0",
        "passport-apple": "^2.0.2",
        "passport-custom": ">=1.1.0",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": ">=4.0.0",
        "passport-local": ">=1.0.0",
        "passport-microsoft": "^2.1.0",
        "rxjs": ">=7.0.0"
    },
    "peerDependenciesMeta": {
        "@nestjs/terminus": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-health": {
            "optional": true
        },
        "passport-apple": {
            "optional": true
        },
        "passport-github2": {
            "optional": true
        },
        "passport-google-oauth20": {
            "optional": true
        },
        "passport-microsoft": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "@nestjs/jwt": "12.0.3",
        "@nestjs/passport": "12.0.0",
        "@nestjs/swagger": "12.0.5",
        "@types/passport-apple": "2.0.3",
        "@types/passport-github2": "1.2.9",
        "@types/passport-google-oauth20": "2.0.17",
        "@types/passport-jwt": "4.0.1",
        "@types/passport-local": "1.0.38",
        "@types/passport-microsoft": "2.1.1",
        "@types/qrcode": "1.5.6",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "express": "5.3.0",
        "passport": "0.7.0",
        "passport-custom": "1.2.1",
        "passport-jwt": "4.0.1",
        "passport-local": "1.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Identity & Access"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
