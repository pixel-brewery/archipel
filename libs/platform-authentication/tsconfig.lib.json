{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "outDir": "../../dist",
        "declaration": true,
        "types": ["node"],
        "target": "es2023",
        "strictNullChecks": true,
        "noImplicitAny": true,
        "strictBindCallApply": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts"]
}
