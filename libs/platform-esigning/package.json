{
    "name": "@pixel-brewery/archipel-platform-esigning",
    "version": "0.1.32",
    "description": "Provider-agnostic e-signing infrastructure for NestJS with support for DocuSign, Adobe Sign, Dropbox Sign, and a built-in internal provider.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "adobe-sign": [
                "./src/adobe-sign/index.d.ts"
            ],
            "docusign": [
                "./src/docusign/index.d.ts"
            ],
            "dropbox-sign": [
                "./src/dropbox-sign/index.d.ts"
            ],
            "internal": [
                "./src/internal/index.d.ts"
            ],
            "health": [
                "./src/health/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./adobe-sign": {
            "types": "./src/adobe-sign/index.d.ts",
            "import": "./src/adobe-sign/index.js",
            "default": "./src/adobe-sign/index.js"
        },
        "./docusign": {
            "types": "./src/docusign/index.d.ts",
            "import": "./src/docusign/index.js",
            "default": "./src/docusign/index.js"
        },
        "./dropbox-sign": {
            "types": "./src/dropbox-sign/index.d.ts",
            "import": "./src/dropbox-sign/index.js",
            "default": "./src/dropbox-sign/index.js"
        },
        "./internal": {
            "types": "./src/internal/index.d.ts",
            "import": "./src/internal/index.js",
            "default": "./src/internal/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-esigning"
    },
    "keywords": [
        "nestjs",
        "esigning",
        "e-signature",
        "docusign",
        "adobe-sign",
        "dropbox-sign",
        "internal",
        "digital-signature",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@pixel-brewery/archipel-platform-configuration": "0.1.32",
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@dropbox/sign": ">=1.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@pixel-brewery/archipel-platform-health": "0.1.32",
        "docusign-esign": ">=8.0.0"
    },
    "peerDependenciesMeta": {
        "@dropbox/sign": {
            "optional": true
        },
        "@nestjs/terminus": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-health": {
            "optional": true
        },
        "docusign-esign": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Infrastructure"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
