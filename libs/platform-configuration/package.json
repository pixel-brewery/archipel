{
    "name": "@pixel-brewery/archipel-platform-configuration",
    "version": "0.1.27",
    "description": "Type-safe configuration management with strategy-based resolution for NestJS applications.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-configuration"
    },
    "keywords": [
        "nestjs",
        "configuration",
        "config",
        "environment",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "typesVersions": {
        "*": {
            "file": [
                "./src/file/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./file": {
            "types": "./src/file/index.d.ts",
            "import": "./src/file/index.js",
            "default": "./src/file/index.js"
        }
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "dotenv": ">=16.0.0"
    },
    "peerDependenciesMeta": {
        "dotenv": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "dotenv": "18.0.8",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Foundation"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
