{
    "name": "@pixel-brewery/archipel-platform-documents",
    "version": "0.1.26",
    "description": "Document generation engine supporting DOCX and PDF with template-based rendering for NestJS.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-documents"
    },
    "keywords": [
        "nestjs",
        "documents",
        "pdf",
        "docx",
        "templates",
        "generation",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "typesVersions": {
        "*": {
            "sharp": [
                "./src/sharp/index.d.ts"
            ],
            "docx": [
                "./src/docx/index.d.ts"
            ],
            "pdf": [
                "./src/pdf/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./sharp": {
            "types": "./src/sharp/index.d.ts",
            "import": "./src/sharp/index.js",
            "default": "./src/sharp/index.js"
        },
        "./docx": {
            "types": "./src/docx/index.d.ts",
            "import": "./src/docx/index.js",
            "default": "./src/docx/index.js"
        },
        "./pdf": {
            "types": "./src/pdf/index.d.ts",
            "import": "./src/pdf/index.js",
            "default": "./src/pdf/index.js"
        }
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@pixel-brewery/archipel-platform-core": "0.1.26",
        "@pixel-brewery/archipel-platform-resources": "0.1.26",
        "tslib": "2.8.1",
        "type-fest": "5.10.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "docxtemplater": ">=3.50.0",
        "pdf-lib": ">=1.17.0",
        "pizzip": ">=3.0.0",
        "sharp": ">=0.33.0"
    },
    "peerDependenciesMeta": {
        "docxtemplater": {
            "optional": true
        },
        "pdf-lib": {
            "optional": true
        },
        "pizzip": {
            "optional": true
        },
        "sharp": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "@pixel-brewery/archipel-platform-configuration": "0.1.26",
        "docxtemplater": "3.71.1",
        "pdf-lib": "1.17.1",
        "pizzip": "3.3.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "sharp": "0.35.5",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Infrastructure"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
