{
    "name": "@pixel-brewery/archipel-platform-reporting",
    "version": "0.1.25",
    "description": "Business reporting framework with pluggable data contributors and query execution for NestJS.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-reporting"
    },
    "keywords": [
        "nestjs",
        "reporting",
        "analytics",
        "business-intelligence",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0"
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Operations"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
