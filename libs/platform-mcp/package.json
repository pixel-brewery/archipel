{
    "name": "@pixel-brewery/archipel-platform-mcp",
    "version": "0.1.26",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "client": [
                "./src/client/index.d.ts"
            ],
            "health": [
                "./src/health/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./client": {
            "types": "./src/client/index.d.ts",
            "import": "./src/client/index.js",
            "default": "./src/client/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        }
    },
    "license": "MIT",
    "description": "Reusable MCP server and bounded Streamable HTTP tool client for NestJS applications",
    "keywords": [
        "mcp",
        "mcp-client",
        "mcp-server",
        "model-context-protocol",
        "nestjs",
        "llm",
        "ai",
        "archipel"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-mcp"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "THIRD_PARTY_NOTICES.md",
        "LICENSE"
    ],
    "dependencies": {
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@modelcontextprotocol/sdk": ">=1.20.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@pixel-brewery/archipel-platform-health": "0.1.26",
        "express": ">=5.0.0",
        "zod": ">=3.25.0"
    },
    "peerDependenciesMeta": {
        "@nestjs/terminus": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-health": {
            "optional": true
        }
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.32.1",
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "express": "5.3.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5",
        "zod": "4.6.7"
    },
    "archipel": {
        "category": "Operations"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
