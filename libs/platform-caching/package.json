{
    "name": "@pixel-brewery/archipel-platform-caching",
    "version": "0.1.33",
    "description": "Layered caching infrastructure for NestJS with in-memory LRU+TTL+SWR and Redis-backed implementations.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "redis": [
                "./src/redis/index.d.ts"
            ],
            "health": [
                "./src/health/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./redis": {
            "types": "./src/redis/index.d.ts",
            "import": "./src/redis/index.js",
            "default": "./src/redis/index.js"
        },
        "./postgres": {
            "types": "./src/postgres/index.d.ts",
            "import": "./src/postgres/index.js",
            "default": "./src/postgres/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-caching"
    },
    "keywords": [
        "nestjs",
        "caching",
        "redis",
        "lru",
        "ttl",
        "stale-while-revalidate",
        "layered-cache",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "tslib": "2.8.1"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@pixel-brewery/archipel-platform-configuration": "0.1.33",
        "@pixel-brewery/archipel-platform-health": "0.1.33",
        "ioredis": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "@nestjs/terminus": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-configuration": {
            "optional": true
        },
        "@pixel-brewery/archipel-platform-health": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "ioredis": "6.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.0.5"
    },
    "archipel": {
        "category": "Infrastructure"
    },
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    }
}
