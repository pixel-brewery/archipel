{
    "name": "@pixel-brewery/archipel-platform-telemetry",
    "version": "0.1.26",
    "description": "OpenTelemetry tracing and metrics with optional direct numeric measurements for NestJS.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "typesVersions": {
        "*": {
            "health": [
                "./src/health/index.d.ts"
            ],
            "otel": [
                "./src/otel/index.d.ts"
            ],
            "otel/bootstrap": [
                "./src/otel/bootstrap/index.d.ts"
            ],
            "otel/providers/otlp-http": [
                "./src/otel/providers/otlp-http/index.d.ts"
            ],
            "otel/providers/otlp-grpc": [
                "./src/otel/providers/otlp-grpc/index.d.ts"
            ],
            "otel/providers/prometheus": [
                "./src/otel/providers/prometheus/index.d.ts"
            ],
            "otel/providers/console": [
                "./src/otel/providers/console/index.d.ts"
            ],
            "measurements": [
                "./src/measurements/index.d.ts"
            ],
            "measurements/providers/empty": [
                "./src/measurements/providers/empty/index.d.ts"
            ],
            "measurements/providers/vercel": [
                "./src/measurements/providers/vercel/index.d.ts"
            ],
            "measurements/providers/new-relic": [
                "./src/measurements/providers/new-relic/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./health": {
            "types": "./src/health/index.d.ts",
            "import": "./src/health/index.js",
            "default": "./src/health/index.js"
        },
        "./otel": {
            "types": "./src/otel/index.d.ts",
