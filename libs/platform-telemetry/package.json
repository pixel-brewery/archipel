            "types": "./src/otel/bootstrap/index.d.ts",
            "import": "./src/otel/bootstrap/index.js",
            "default": "./src/otel/bootstrap/index.js"
        },
        "./otel/providers/otlp-http": {
            "types": "./src/otel/providers/otlp-http/index.d.ts",
