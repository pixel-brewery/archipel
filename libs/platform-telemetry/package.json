        "./otel/providers/console": {
            "types": "./src/otel/providers/console/index.d.ts",
            "import": "./src/otel/providers/console/index.js",
            "default": "./src/otel/providers/console/index.js"
        },
        "./measurements": {
            "types": "./src/measurements/index.d.ts",
            "import": "./src/measurements/index.js",
            "default": "./src/measurements/index.js"
        },
        "./measurements/providers/empty": {
            "types": "./src/measurements/providers/empty/index.d.ts",
            "import": "./src/measurements/providers/empty/index.js",
            "default": "./src/measurements/providers/empty/index.js"
        },
        "./measurements/providers/vercel": {
            "types": "./src/measurements/providers/vercel/index.d.ts",
            "import": "./src/measurements/providers/vercel/index.js",
            "default": "./src/measurements/providers/vercel/index.js"
        },
        "./measurements/providers/new-relic": {
            "types": "./src/measurements/providers/new-relic/index.d.ts",
            "import": "./src/measurements/providers/new-relic/index.js",
            "default": "./src/measurements/providers/new-relic/index.js"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git",
        "directory": "libs/platform-telemetry"
    },
    "keywords": [
        "nestjs",
        "opentelemetry",
        "tracing",
        "metrics",
        "observability",
        "archipel"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "files": [
        "src/**/*.js",
        "src/**/*.d.ts",
        "README.md",
        "LICENSE"
