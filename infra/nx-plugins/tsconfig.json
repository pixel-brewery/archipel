{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "outDir": "../../dist/out-tsc/infra/nx-plugins",
        "rootDir": "src",
        "sourceMap": false,
        "tsBuildInfoFile": "../../dist/out-tsc/infra/nx-plugins/tsconfig.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
