{
    "name": "archipel",
    "version": "1.0.0",
    "description": "Archipel backend generic libraries monorepo",
    "keywords": [
        "backend",
        "nestjs",
        "typescript",
        "nodejs",
        "libraries",
        "provider-agnostic",
        "prisma",
        "authentication",
        "observability",
        "ai-agents",
        "mcp",
        "monorepo",
        "nx"
    ],
    "homepage": "https://pixel-brewery.github.io/archipel/",
    "bugs": {
        "url": "https://github.com/pixel-brewery/archipel/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/archipel.git"
    },
    "author": "Archipel",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.13.0",
    "engines": {
        "node": ">=22.18.0",
        "yarn": ">=4.0.0"
    },
    "scripts": {
        "nx": "nx",
        "agents:check": "python3 .agents/scripts/sync_architect_core.py --check",
        "postinstall": "prisma generate",
        "build": "nx run-many --target=build --projects=tag:backend,tag:tool --parallel=1",
        "test": "nx run-many --target=test --projects=tag:backend,tag:tool --parallel=1 --maxWorkers=1",
        "lint": "nx run-many --target=lint --parallel=1",
        "typecheck": "nx run-many --target=build --projects=tag:backend,tag:tool --parallel=1",
        "docs": "nx run-many --target=docs --projects=tag:backend --parallel=1",
        "docs:dev": "nx run docs:dev",
        "docs:build": "nx run docs:build",
        "docs:preview": "nx run docs:preview",
        "format": "nx format:write --all",
        "format:check": "nx format:check --all",
        "release": "yarn run release:patch",
        "release:first": "yarn run release:patch",
        "release:first:dry-run": "yarn run release:nx --specifier=patch --first-release --dry-run",
        "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
        "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
        "release:dry-run": "yarn run release:nx --specifier=patch --dry-run",
        "release:nx": "nx release --skip-publish",
        "release:publish": "yarn build && yarn verify:esm && nx release publish --nxBail --outputStyle=static",
        "release:verify": "node tools/verify-published-packages.mjs",
        "prepare": "yarn run format && yarn run lint && yarn run test",
        "serve": "nx run docs:dev",
        "update": "yarn upgrade-interactive",
        "spell": "cspell --gitignore .",
        "verify:esm": "node tools/verify-esm-packages.mjs",
        "verify": "yarn agents:check && yarn public:check && yarn format && yarn verify:checks",
        "verify:ci": "yarn agents:check && yarn public:check && yarn format:check && yarn verify:checks",
        "verify:checks": "yarn ci:check && yarn lint && yarn test && yarn spell && yarn docs && yarn build && yarn verify:esm",
        "public:check": "node .github/scripts/findPrivateReferences.mjs",
        "release:major": "gh workflow run release.yml --ref main -f specifier=major",
        "ci:check": "vitest run --config=.github/scripts/vitest.config.mjs",
        "packaging:test": "vitest run --config=.github/scripts/vitest.config.mjs tools/verify-esm-packages.spec.mjs tools/verify-published-packages.spec.mjs"
    },
    "dependencies": {
        "@nestjs/common": "12.4.2",
        "@nestjs/core": "12.4.2",
        "@nestjs/platform-express": "12.4.2",
        "express": "5.3.0",
        "passport": "0.7.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "tslib": "2.9.1"
    },
    "devDependencies": {
        "@ai-sdk/anthropic": "4.0.102",
        "@ai-sdk/gateway": "4.0.143",
        "@ai-sdk/google": "4.0.118",
        "@ai-sdk/openai": "4.0.115",
        "@ai-sdk/openai-compatible": "3.0.90",
        "@ai-sdk/provider": "4.0.37",
        "@ai-sdk/xai": "5.0.43",
        "@aws-sdk/client-s3": "^3.1167.0",
        "@aws-sdk/s3-request-presigner": "^3.1167.0",
        "@azure/service-bus": "^7.10.0",
        "@azure/storage-blob": "^12.34.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@dropbox/sign": "1.15.0",
        "@eslint/js": "10.0.1",
        "@lemonsqueezy/lemonsqueezy.js": "4.0.0",
        "@mollie/api-client": "4.6.0",
        "@nestjs/schematics": "12.0.13",
        "@nestjs/testing": "12.4.2",
        "@nx/eslint": "24.0.6",
        "@nx/eslint-plugin": "24.0.6",
        "@nx/js": "24.0.6",
        "@nx/node": "24.0.6",
        "@nx/vite": "24.0.6",
        "@nx/vitest": "24.0.6",
        "@nx/web": "24.0.6",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/context-async-hooks": "3.1.1",
        "@opentelemetry/core": "3.1.1",
        "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.1",
        "@opentelemetry/exporter-prometheus": "0.301.1",
        "@opentelemetry/instrumentation": "0.301.1",
        "@opentelemetry/sdk-metrics": "3.1.1",
        "@opentelemetry/sdk-trace": "3.1.1",
        "@paddle/paddle-node-sdk": "3.11.1",
        "@prisma/client": "7.10.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.22",
        "@swc/helpers": "0.5.24",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "^1.8.1",
        "@types/docusign-esign": "5.19.9",
        "@types/express": "5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/node": "26.6.6",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "@types/ws": "8.18.2",
        "@typescript-eslint/parser": "8.72.2",
        "@typescript-eslint/utils": "8.72.2",
        "@vercel/functions": "3.11.1",
        "@vercel/queue": "^0.11.0",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/ui": "5.1.0",
        "ai": "7.0.170",
        "applicationinsights": "^3.17.0",
        "bullmq": "^6.7.5",
        "compression": "^1.8.2",
        "conventional-changelog-atom": "^5.1.0",
        "cspell": "10.4.1",
        "dd-trace": "^6.24.0",
        "docusign-esign": "10.1.0",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "express-rate-limit": "^8.7.4",
        "express-session": "^1.19.0",
        "helmet": "^8.3.0",
        "husky": "9.1.7",
        "jsdom": "31.0.0",
        "jsonc-eslint-parser": "3.3.0",
        "lint-staged": "17.6.0",
        "nx": "24.0.6",
        "pg": "8.23.1",
        "prettier": "3.10.1",
        "prisma": "7.10.1",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vite": "8.3.8",
        "vitest": "5.1.0",
        "ws": "8.22.2",
        "zod": "4.6.7"
    },
    "workspaces": [
        "libs/*",
        "apps/*",
        "apps/frontend/*",
        "tools/*",
        "infra/*"
    ]
}
